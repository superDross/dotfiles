[pull]
	rebase = false

; [pager]
; 	diff = less
; 	log = cat

[core]
	pager = less
[log]
	abbrevCommit = false
[color "diff"]
	; unchanged code around diffs
	context = normal
	; file name etc.
	meta = brightblue ul
	; lines deleted/added
	frag = brightmagenta italic
	; class/func name
	func = yellow bold
	old = red bold
	new = green bold
	; commit headers
	commit = cyan bold
[alias]
	# stolen from https://stackoverflow.com/questions/1838873/visualizing-branch-topology-in-git/34467298#34467298
	lg = log --abbrev-commit --decorate --format=tformat:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	slog = !git --no-pager lg -n 12
	graph = lg --graph --abbrev-commit --decorate --format=tformat:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
	sgraph = !git --no-pager graph -n 12

	# list of changed files in a given commit
	cfiles = diff-tree --no-commit-id --name-only -r
[init]
	defaultBranch = main
