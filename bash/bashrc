function ffind() {
  if cmd="$(type -p "rg")" || [[ -x $cmd ]]; then
    rg "${@:2}" --type "$1" -g '!**/venv/*' -g '!**/.tox/*'
  # add ag alternative
  else
    find . -type f -name "*.$1" ! -path '*/venv/*' ! -path '*/.tox/*' | xargs grep "${@:2}"
  fi
}

function ftype() {
  find . -iname "*.${@}"
}

# parse git or hg branch name and stash number
function parse_git_branch() {
  if [[ $(command -v git) ]]; then
    if git ls-files >&/dev/null; then
      branch=$(git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/')
      # remove feature/bugfix etc. from branch name
      branch_without_prefix=$(echo $branch | sed 's/[a-zA-Z].*\///')
      stash_num=$(git stash list | grep "$branch_without_prefix" | wc -l | sed 's/^ *//g')
      if [ "$stash_num" = 0 ]; then
        echo " (${branch})"
      else
        echo " (${branch}) ${stash_num}"
      fi
    elif [ -d .hg ]; then
      hg branch 2>/dev/null | awk '{ print " hg (" $1 ")" }'
    fi
  fi
}

function bg_process_num() {
  num=$(jobs | grep -v autojump | wc -l | sed 's/^ *//g')
  if [ $num != 0 ]; then
    echo " $num"
  fi
}

function tmux_session() {
  # if tmux on system and in a session
  if [[ $(command -v tmux) ]] && [ -n "$TMUX" ]; then
    echo "(tmux) "
  fi
}

function tmux_session_num() {
  # if tmux on system and not in a session
  if [[ $(command -v tmux) ]] && [ -z "$TMUX" ]; then
    session_num=$(tmux ls 2> /dev/null | wc -l | sed 's/^ *//g')
    if [ $session_num != 0 ]; then
      echo " $session_num"
    fi
  fi
}

