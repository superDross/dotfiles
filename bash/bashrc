function fuzzy-kill() {
  # BE CAREFUL: kills all processes containing the given substring
  if [[ -z "$1" ]]; then
    echo "You must provide an argument"
  fi
  sudo kill $(ps -aef | grep "$1" | awk '{print $2}' | xargs)
}

function docker_stop_all(){
  # not using `docker ps -q` as we want to make minikube an exception
  containers=$(docker ps | tail -n +2 | grep -v minikube | awk '{print $1}')
  docker stop $containers
}

function docker_plus_help(){
cat <<- EOF
Commands:
  logs: see containers logs
  bash: jump into a containers bash shell
  psql: jump into a postgres containers psql shell
EOF
}

function docker_clean_up(){
  read -p "[WARNING] this will remove all Docker related files. Continue? (y/n) $ " answer
  case $answer in
    y | yes | Y | YES)
      docker system prune --force
      docker container stop $(docker container ls -aq)
      docker container rm $(docker container ls -aq)
      docker rmi $(docker images -aq)
      docker volume prune --force
      ;;
    n | no | N | NO)
      echo "Exiting..."
      ;;
    *)
      echo "Answer ${answer} unknown. Exiting..."
      ;;
  esac

}


function remove_debugger() {
  # Removes all python debugger statements from py files in a given dir
  #   $1: directory to recursively search for py files must be absolute path (default: current directory)

  directory="$1"
  suffix="py"

  if [ -z "$1" ]; then
    directory=$(pwd)
  fi

  message=$(\
    rg \
    'import pdb.*|.*pdb.set_trace.*|.*remote_pdb.*|.*RemotePdb.*|.*breakpoint\(\)' \
    --type $suffix \
    --pretty \
    $directory \
  )
  # get only the file names (sed removes colours)
  files=$(echo "$message" | sed 's/\x1b\[[0-9;]*m//g' | grep "\.${suffix}\>")

  # remove the 4444:4444 exposed port liness from the docker-compose files
  port_message=$(rg --files -g '*docker-compose.*' | xargs rg --pretty '4444:4444')
  docker_files=$(echo "$port_message" | sed 's/\x1b\[[0-9;]*m//g' | rg "docker-compose")

  if [ -z "$message" ] && [ -z "$port_message" ]; then
    echo "No debugging statements found. Exiting..."
    return 0
  fi

  echo "$message"
  echo "$port_message"
  read -p "Do you want to remove the above debugger lines? (y/n) $ " answer

  case $answer in
    y | yes | Y | YES)
      echo $files $docker_files | \
        xargs sed --in-place \
        '/import pdb/d;/pdb.set_trace/d;/remote_pdb/d;/RemotePdb/d;/breakpoint()/d;/4444:4444/d'
      echo "Complete"
      ;;
    n | no | N | NO)
      echo "Exiting..."
      ;;
    *)
      echo "Answer ${answer} unknown. Exiting..."
      ;;
  esac
}

