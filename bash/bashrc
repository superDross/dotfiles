function generate_pyrightconfig() {
  # check if a pyright config file already exists
  if [ -f pyrightconfig.json ]; then
    echo -e "${YELLOW}A pyrightconfig.json already exists, exiting...${NC}"
  elif poetry env info -p >&/dev/null; then
    poetry_env=$(poetry env info -p)
    venv_name=$(basename "$poetry_env")
    venv_dir=$(dirname "$poetry_env")
    echo "{
      \"venvPath\": \"${venv_dir}\",
      \"venv\": \"${venv_name}\",
      \"autoImportCompletions\": true,
      \"typeCheckingMode\": \"off\",
      \"ignore\": [
        \"*\"
      ]
    }" >pyrightconfig.json
  else
    echo -e "${YELLOW}Poetry environment not found. Please run 'poetry install' first.${NC}"
  fi
}

function docker_stop_all() {
  # not using `docker ps -q` as we want to make minikube an exception
  containers=$(docker ps | tail -n +2 | grep -v minikube | awk '{print $1}' | tr '\n' ' ')
  if [ "$containers" != "" ]; then
    # shellcheck disable=SC2086
    docker stop $containers
  else
    echo "No containers to stop"
  fi
}

function docker_plus_help() {
  cat <<-EOF
		Commands:
		  logs: see containers logs
		  bash: jump into a containers bash shell
		  psql: jump into a postgres containers psql shell
	EOF
}

function docker_clean_up() {
  read -r -p "[WARNING] this will remove all Docker related files. Continue? (y/n) $ " answer
  case $answer in
  y | yes | Y | YES)
    docker system prune -af
    docker container stop "$(docker container ls -aq)"
    docker container rm "$(docker container ls -aq)"
    docker rmi "$(docker images -aq)"
    docker volume prune --force
    ;;
  n | no | N | NO)
    echo "Exiting..."
    ;;
  *)
    echo "Answer ${answer} unknown. Exiting..."
    ;;
  esac

}

function docker_plus() {
  # Wrapper for some docker cli commands:
  #   $1: docker_plus command
  #   $2: part or full container name
  if [ "$(docker ps -q)" = "" ]; then
    echo "No docker containers are running."
    return
  fi
  container_id=$(docker ps | awk '$NF ~ /'"$2"'/ {print $1}' | head -n 1)
  container_name=$(docker ps | awk '$NF ~ /'"$2"'/ {print $NF}' | head -n 1)
  case $1 in
  help)
    docker_plus_help
    ;;
  logs | log)
    echo -e "Getting logs for ${YELLOW}${container_name}${NC}..."
    sleep 1
    docker logs "$container_id" -f
    ;;
  bash)
    echo -e "Jumping into ${YELLOW}${container_name}${NC} bash shell..."
    sleep 1
    docker exec -it "$container_id" /bin/bash
    ;;
  shell)
    echo -e "Jumping into ${YELLOW}${container_name}${NC} shell..."
    sleep 1
    docker exec -it "$container_id" /bin/sh
    ;;
  psql)
    # $3: database name
    db_name=$([ "$3" = "" ] && echo "postgres" || echo "$3")
    echo -e "Jumping into ${YELLOW}${container_name}${NC} (${db_name}) psql shell..."
    sleep 1
    docker exec -it "$container_id" psql -U postgres -d "$db_name"
    ;;
  *)
    echo "ERROR: ${2} is not a valid command. See 'docker_plus help'."
    ;;
  esac
}

# parse git or hg branch name and stash number
function parse_git_branch() {
  if [[ $(command -v git) ]]; then
    if git ls-files >&/dev/null; then
      branch=$(git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/')
      # remove feature/bugfix etc. from branch name
      branch_without_prefix=$(echo "$branch" | sed 's/[a-zA-Z].*\///')
      stash_num=$(git stash list | grep -c "$branch_without_prefix" | sed 's/^ *//g')
      if [ "$stash_num" = 0 ]; then
        echo " (${branch})"
      else
        echo " (${branch}) ${stash_num}"
      fi
    elif [ -d .hg ]; then
      hg branch 2>/dev/null | awk '{ print " hg (" $1 ")" }'
    fi
  fi
}

function bg_process_num() {
  num=$(jobs | grep -c -v "autojump\|wezterm\|zoxide" | sed 's/^ *//g')
  if [ "$num" != 0 ]; then
    echo " $num"
  fi
}

# go up x many dirs:
#    up 2 == cd ../../
function up() {
  if [[ "$#" == 0 ]]; then
    cd ..
  else
    CDSTR=""
    for _ in $(seq 1 "$1"); do
      CDSTR="../$CDSTR"
    done
    cd "$CDSTR" || exit
  fi
}

