# FFind
#
# rg/grep wrapper
#   ffind <file-ext> <query>
#
# Example:
#   find all class in all python files recursively
#     ffind py class
ffind() {
  if cmd="$(type -p "rg")" || [[ -x $cmd ]]; then
    rg "${@:2}" --type "$1" -g '!**/venv/*' -g '!**/.tox/*'
  # add ag alternative
  else
    find . -type f -name "*.$1" ! -path '*/venv/*' ! -path '*/.tox/*' | xargs grep "${@:2}"
  fi
}

# parse git or hg branch name and stash number
parse_git_branch() {
  if git ls-files >&/dev/null; then
    branch=$(git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/')
    stash_num=$(git stash list | grep "$branch" | wc -l | sed 's/^ *//g')
    if [ "$stash_num" = 0 ]; then
      echo " (${branch})"
    else
      echo " (${branch}) ${stash_num}"
    fi
  elif [ -d .hg ]; then
    hg branch 2>/dev/null | awk '{ print " hg (" $1 ")" }'
  fi
}

bg_process_num() {
  num=$(jobs | grep -v autojump | wc -l | sed 's/^ *//g')
  if [ $num != 0 ]; then
    echo " $num"
  fi
}

# multiple git 'aliases'
git() {
  if [[ $@ == 'graph' ]]; then
    command git log --graph --oneline --decorate --all
  elif [[ $@ == 'current-tag' ]]; then
    command git describe --tags --abbrev=0
  else
    command git "$@"
  fi
}

# go up x many dirs:
#    up 2 == cd ../../
up() {
  if [[ "$#" == 0 ]]; then
    cd ..
  else
    CDSTR=""
    for i in $(seq 1 $1); do
      CDSTR="../$CDSTR"
    done
    cd $CDSTR
  fi
}

# stream torrent magnet in VLC
