# multiple git 'aliases'
function git() {
  if [[ $@ == 'graph' ]]; then
    command git log --graph --oneline --decorate --all
  elif [[ $@ == 'current-tag' ]]; then
    command git describe --tags --abbrev=0
  else
    command git "$@"
  fi
}

# go up x many dirs:
#    up 2 == cd ../../
function up() {
  if [[ "$#" == 0 ]]; then
    cd ..
  else
    CDSTR=""
    for i in $(seq 1 $1); do
      CDSTR="../$CDSTR"
    done
    cd $CDSTR
  fi
}

