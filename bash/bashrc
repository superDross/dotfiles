function docker_plus(){
  # Wrapper for some docker cli commands: 
  #   $1: docker_plus command
  #   $2: part or full container name
  if [ -z "$(docker ps -q)" ]; then
    echo "No docker containers are running."
    return
  fi
  container_id=$(docker ps | awk '$NF ~ /'$2'/ {print $1}' | head -n 1)
  container_name=$(docker ps | awk '$NF ~ /'$2'/ {print $NF}' | head -n 1)
  case $1 in
    help)
      docker_plus_help
      ;;
    logs | log)
      echo -e "Getting logs for ${YELLOW}${container_name}${NC}..."
      sleep 1
      docker logs $container_id -f
      ;;
    bash)
      echo -e "Jumping into ${YELLOW}${container_name}${NC} bash shell..."
      sleep 1
      docker exec -it $container_id /bin/bash
      ;;
    shell)
      echo -e "Jumping into ${YELLOW}${container_name}${NC} shell..."
      sleep 1
      docker exec -it $container_id /bin/sh
      ;;
    psql)
      # $3: database name
      db_name=$([ -z "$3" ] && echo "postgres" || echo "$3")
      echo -e "Jumping into ${YELLOW}${container_name}${NC} (${db_name}) psql shell..."
      sleep 1
      docker exec -it $container_id psql -U postgres -d $db_name
      ;;
    *)
      echo "ERROR: ${2} is not a valid command. See 'docker_plus help'."
      ;;
  esac
}


# parse git or hg branch name and stash number
function parse_git_branch() {
  if [[ $(command -v git) ]]; then
    if git ls-files >&/dev/null; then
      branch=$(git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/')
      # remove feature/bugfix etc. from branch name
      branch_without_prefix=$(echo $branch | sed 's/[a-zA-Z].*\///')
      stash_num=$(git stash list | grep "$branch_without_prefix" | wc -l | sed 's/^ *//g')
      if [ "$stash_num" = 0 ]; then
        echo " (${branch})"
      else
        echo " (${branch}) ${stash_num}"
      fi
    elif [ -d .hg ]; then
      hg branch 2>/dev/null | awk '{ print " hg (" $1 ")" }'
    fi
  fi
}

function bg_process_num() {
  num=$(jobs | grep -c -v "autojump\|wezterm" | sed 's/^ *//g')
  if [ "$num" != 0 ]; then
    echo " $num"
  fi
}

# go up x many dirs:
#    up 2 == cd ../../
function up() {
  if [[ "$#" == 0 ]]; then
    cd ..
  else
    CDSTR=""
    for i in $(seq 1 $1); do
      CDSTR="../$CDSTR"
    done
    cd $CDSTR
  fi
}

# $1: service name
# $2: port
# $3: namespace (optional)
# $4: beamery environment (optional)
# example, prometheus in candidate-matching: port_forward_synergy candidate 8008
function port_forward_synergy() {
  if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo -e "\n${YELLOW}port_forward_synergy${NC} port forward to synergy service in staging env"
    echo -e "${BLUE}Usage${NC}:\t\tport_forward_synergy <service_name> <port> <namespace> <beam_env>"
    echo -e "${PURPLE}Example${NC}:\tport_forward_synergy candidate 8002 synergy beamery-staging\n"
    return 0
  fi
  namespace="${3:-synergy}"
  beam_env="${4:-beamery-staging}"
  service=$(kube_cloudflare.sh "$beam_env" kubectl -n "$namespace" get services | grep "$1" | awk 'FNR == 1{print $1}')
  kube_cloudflare.sh "$beam_env" kubectl -n "$namespace" port-forward "service/${service}" "${2}:${2}"
}


