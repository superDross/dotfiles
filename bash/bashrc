  # use CTRL+Z and then type `bg` to take back your terminal
  peerflix "$1" --remove --vlc --quiet --list
}

# VirtualJump
#
# activates a virtual env
#   v <app-name> <dir>
#
# Example:
#  activate pangaea virtual env
#    v pangaea/
#  activate capn virtual env within dev dir
#    v capn/ ~/dev
v() {
  if [[ -z "$1" ]]; then
    echo please supply an app name
    return 1
  fi

  # get optional dir arg
  if [[ -z "$2" ]]; then
    local dir=~
  else
    local dir=$2
  fi

  local venv_dir=$(find "$dir" -maxdepth 6 -not -path '*/\.*' -name venv -type d 2>&1 | grep -i "$1")
  local matches=$(echo "$venv_dir" | wc -w)

  if [[ $matches -gt 1 ]]; then
    echo "[ERROR] too many matches: $venv_dir"
    return 1
  elif [[ $matches -lt 1 ]]; then
    echo "[ERROR] no matches found for $1"
    return 1
  fi

  local activate=${venv_dir}/bin/activate
  echo "[ACTIVATING] $activate"
  source $activate
  cd $(dirname ${venv_dir})
}

