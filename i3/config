################
#    CONFIG    #
################

set $mod Mod4
font pango:System San Fransisco Display 11

########################
#      GENERAL         #
########################

focus_follows_mouse no


#########################
#       VARIABLES       #
#########################

set $wallpaper ~/Downloads/wallpaper.jpg

# colors
set $yellow #ffee00
set $cyan #0ee1ed
set $light_gray #efefef
set $gray #adadad
set $black #000000
set $white #ffffff
set $very_purple #3d0ae5

# color scheme
set $firefox_orange #E55B0A
set $light_teal #64baaa
set $pale_green #c4fcf0
set $muddy_green #4c8076



############################
#    WINDOW APPEARANCE     #
############################

# remove top border
for_window [class="^.*"] border pixel 3

# class                 border  backgr. text    indicator child_border
client.focused          $grey  $white  $black  $light_teal
client.focused_inactive #333333 #5f676a $white #484e50   #5f676a
client.unfocused        #333333 #333333 #888888 #292d2e   #222222
client.urgent           #2f343a #900000 $white #900000   #900000
client.placeholder      #000000 #0c0c0c $white #000000   #0c0c0c

client.background       $white


###################
#    SHORTCUTS    #
###################

# toggle active window as sticky
bindsym $mod+Shift+s sticky toggle

# use scrot for print screen
bindsym Print exec scrot

# start a terminal
bindsym $mod+Return exec xfce4-terminal --hide-menubar

# lock screen activation
bindsym $mod+Shift+x exec i3lock-fancy

# kill focused window
bindsym $mod+Shift+q kill

# start dmenu (a program launcher)
bindsym $mod+d exec dmenu_run -nf '#BBBBBB' -nb '#333333' -sb '#4c8076' -sf '#EEEEEE'

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+p split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# reload the configuration file
bindsym $mod+Shift+c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

# no more gaps
bindsym $mod+n gaps outer current set 0; gaps inner current set 0

# gaps default size
bindsym $mod+o gaps outer current set 15; gaps inner current set 15


##################
#    MEDIA       #
##################

# NOTE: if no audio then deleting the files in ~/.config/pulse
#       and restarting the machine solves the issue

# # Pulse Audio controls
bindsym XF86AudioMute exec amixer -q -D pulse sset Master toggle
bindsym XF86AudioLowerVolume exec amixer -q -D pulse sset Master 5%-
bindsym XF86AudioRaiseVolume exec amixer -q -D pulse sset Master 5%+

# # Media player controls
bindsym XF86AudioPlay exec playerctl play-pause || dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause

bindsym XF86AudioPause exec playerctl pause || dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause

bindsym XF86AudioNext exec playerctl next || dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next

bindsym XF86AudioPrev exec playerctl previous || dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous


##################
#   WORKSPACES   #
##################

# icon cheatsheet: https://fontawesome.com/cheatsheet
set $workspace1 "1: "
set $workspace2 "2: "
set $workspace3 "3: "
set $workspace4 "4: "
set $workspace5 "5: "
set $workspace6 "6: "
set $workspace7 "7: "

# switch to workspace
bindsym $mod+1 workspace $workspace1
bindsym $mod+2 workspace $workspace2
bindsym $mod+3 workspace $workspace3
bindsym $mod+4 workspace $workspace4
bindsym $mod+5 workspace $workspace5
bindsym $mod+6 workspace $workspace6
bindsym $mod+7 workspace $workspace7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+10 workspace 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $workspace1
bindsym $mod+Shift+2 move container to workspace $workspace2
bindsym $mod+Shift+3 move container to workspace $workspace3
bindsym $mod+Shift+4 move container to workspace $workspace4
bindsym $mod+Shift+5 move container to workspace $workspace5
bindsym $mod+Shift+6 move container to workspace $workspace6
bindsym $mod+Shift+7 move container to workspace $workspace7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+10 move container to workspace 10

# opens specific applications in given workspace windows
assign [class="firefox"] $workspace4
assign [class="TelegramDesktop"] $workspace6
assign [class="chromium"] $workspace6
for_window [class="Spotify"] move to workspace $workspace6
assign [class="Slack"] $workspace7

# only works on floating windows
for_window [instance=vlc] sticky enable


########################
#    START UP APPS     #
########################

# NOTE: use `lightdm-settings` to change the login screen wallpaper
exec_always feh --bg-fill $wallpaper
exec xfce4-terminal --hide-menubar
exec firefox
exec unclutter
exec slack
exec chromium

# background apps
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id compton -b
# network manager (nmcli) icon and gui
exec --no-startup-id nm-applet
# required for brightness keys to work
exec --no-startup-id xfce4-power-manager
# backup system
exec --no-startup-id timeshift
exec --no-startup-id clipit
exec --no-startup-id telegram-desktop
# Tray icon for pulse audio
exec --no-startup-id pasystray

bindsym $mod+Ctrl+m exec xfce4-terminal --hide-menubar -e 'alsamixer'


########################
#     FLOATING APPS    #
########################

for_window [title="alsamixer"] floating enable border pixel 1
for_window [class="calamares"] floating enable border normal
for_window [class="Clipgrab"] floating enable
for_window [title="File Transfer*"] floating enable
for_window [class="fpakman"] floating enable
for_window [class="Galculator"] floating enable border pixel 1
for_window [class="GParted"] floating enable border normal
for_window [title="i3_help"] floating enable sticky enable border normal
for_window [class="Lightdm-settings"] floating enable
for_window [class="Lxappearance"] floating enable sticky enable border normal
for_window [class="Manjaro-hello"] floating enable
for_window [class="Manjaro Settings Manager"] floating enable border normal
for_window [title="MuseScore: Play Panel"] floating enable
for_window [class="Nitrogen"] floating enable sticky enable border normal
for_window [class="Oblogout"] fullscreen enable
for_window [class="octopi"] floating enable
for_window [title="About Pale Moon"] floating enable
for_window [class="Pamac-manager"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="qt5ct"] floating enable sticky enable border normal
for_window [class="Qtconfig-qt4"] floating enable sticky enable border normal
for_window [class="Simple-scan"] floating enable border normal
for_window [class="(?i)System-config-printer.py"] floating enable border normal
for_window [class="Skype"] floating enable border normal
for_window [class="Timeset-gui"] floating enable border normal
for_window [class="(?i)virtualbox"] floating enable border normal
for_window [class="Xfburn"] floating enable


#########################
#    WINDOW RESIZING    #
#########################

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode
        bindsym h resize grow width 5 px or 5 ppt
        bindsym j resize shrink height 5 px or 5 ppt
        bindsym k resize grow height 5 px or 5 ppt
        bindsym l resize shrink width 5 px or 5 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"


########################
#      STATUS BAR      #
########################

hide_edge_borders both

bar {
        colors {
                  # class            border   backgr.  text
                  focused_workspace  #4c7899  $firefox_orange  #ffffff
                  active_workspace   #333333  #5f676a  #ffffff
                  inactive_workspace #333333  #222222  #888888
                  urgent_workspace   #2f343a  $light_teal  #ffffff
                  binding_mode       #2F343A  $muddy_green #FFFFFF
                  # status_line_class    color
                  background             #333333
                  statusline             #FFFFFF
                  separator              #FFFFFF
        }
        status_command i3status --config ~/.i3/i3status.conf
        position top
        tray_output primary
}


#################
#    DISPLAY    #
#################

set $display display: (m)irror (h)ome (w)ork (s)hare
mode "$display" {
  bindsym m exec xrandr --output eDP-1 --mode 1920x1080 --pos 0x0 --rotate normal \
                        --output HDMI-2 --primary --mode 1920x1080 --pos 0x0 --rotate normal
  bindsym h exec xrandr --output HDMI-1 --mode 1920x1080 --pos 0x0 --rotate left \
                        --output eDP-1 --primary --mode 1920x1080 --pos 2040x0 --rotate normal \
                        --output HDMI-2 --mode 1920x1080 --pos 2040x0 --rotate normal
  bindsym w exec xrandr --output eDP-1 --primary --mode 1920x1080 --pos 1920x0 --rotate normal \
                        --output HDMI-2 --mode 1920x1080 --pos 0x0 --rotate left \
                        --output HDMI-1 --mode 1920x1080 --pos 1920x0 --rotate normal
  bindsym s exec xrandr --output eDP-1 --off \
                        --output HDMI-3 --off \
                        --output HDMI-2 --off \
                        --output HDMI-1 --primary --mode 1920x1080 --pos 1920x0 --rotate normal \
                        --output DP-3 --off \
                        --output DP-2 --off \
                        --output DP-1 --off

  bindsym Return mode "default"
  bindsym Escape mode "default"
}

bindsym $mod+Shift+d mode "$display"


set $move move: left (h), right (l)
mode "$move" {
  bindsym l move workspace to output right
  bindsym h move workspace to output left

  bindsym Return mode "default"
  bindsym Escape mode "default"
}

bindsym $mod+m mode "$move"

##################
#     GAPS       #
##################

# gaps only when there is more than one window
# smart_gaps on

# default global gaps
gaps inner 15
gaps outer 15

# gaps for sepcific workplaces
workspace $workspace4 gaps outer 0
workspace $workspace4 gaps inner 0


# help messages when entering gaps mode(s)
set $mode_gaps Gaps: (a)ll, (o)uter, (i)nner, (h)orizontal, (v)ertical, (t)op, (r)ight, (b)ottom, (l)eft
set $mode_gaps_all All Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_outer Outer Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_inner Inner Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_horiz Horizontal Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_verti Vertical Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_top Top Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_right Right Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_bottom Bottom Gaps: j|k|0 (local), Shift + j|k|0 (global)
set $mode_gaps_left Left Gaps: j|k|0 (local), Shift + j|k|0 (global)

mode "$mode_gaps" {
        bindsym a      mode "$mode_gaps_all"
        bindsym o      mode "$mode_gaps_outer"
        bindsym i      mode "$mode_gaps_inner"
        bindsym h      mode "$mode_gaps_horiz"
        bindsym v      mode "$mode_gaps_verti"
        bindsym t      mode "$mode_gaps_top"
        bindsym r      mode "$mode_gaps_right"
        bindsym b      mode "$mode_gaps_bottom"
        bindsym l      mode "$mode_gaps_left"
        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}

mode "$mode_gaps_outer" {
        bindsym j  gaps outer current plus 5
        bindsym k gaps outer current minus 5
        bindsym 0     gaps outer current set 0

        bindsym Shift+j  gaps outer all j 5
        bindsym Shift+k gaps outer all k 5
        bindsym Shift+0     gaps outer all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}
mode "$mode_gaps_inner" {
        bindsym j  gaps inner current plus 5
        bindsym k gaps inner current minus 5
        bindsym 0     gaps inner current set 0

        bindsym Shift+j  gaps inner all j 5
        bindsym Shift+k gaps inner all k 5
        bindsym Shift+0     gaps inner all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}
mode "$mode_gaps_horiz" {
        bindsym j  gaps horizontal current plus 5
        bindsym k gaps horizontal current minus 5
        bindsym 0     gaps horizontal current set 0

        bindsym Shift+j  gaps horizontal all j 5
        bindsym Shift+k gaps horizontal all k 5
        bindsym Shift+0     gaps horizontal all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}
mode "$mode_gaps_verti" {
        bindsym j  gaps vertical current plus 5
        bindsym k gaps vertical current minus 5
        bindsym 0     gaps vertical current set 0

        bindsym Shift+j  gaps vertical all j 5
        bindsym Shift+k gaps vertical all k 5
        bindsym Shift+0     gaps vertical all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}
mode "$mode_gaps_top" {
        bindsym j  gaps top current plus 5
        bindsym k gaps top current minus 5
        bindsym 0     gaps top current set 0

        bindsym Shift+j  gaps top all j 5
        bindsym Shift+k gaps top all k 5
        bindsym Shift+0     gaps top all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}
mode "$mode_gaps_right" {
        bindsym j  gaps right current plus 5
        bindsym k gaps right current minus 5
        bindsym 0     gaps right current set 0

        bindsym Shift+j  gaps right all j 5
        bindsym Shift+k gaps right all k 5
        bindsym Shift+0     gaps right all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}
mode "$mode_gaps_bottom" {
        bindsym j  gaps bottom current plus 5
        bindsym k gaps bottom current minus 5
        bindsym 0     gaps bottom current set 0

        bindsym Shift+j  gaps bottom all j 5
        bindsym Shift+k gaps bottom all k 5
        bindsym Shift+0     gaps bottom all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}
mode "$mode_gaps_left" {
        bindsym j  gaps left current plus 5
        bindsym k gaps left current minus 5
        bindsym 0     gaps left current set 0

        bindsym Shift+j  gaps left all j 5
        bindsym Shift+k gaps left all k 5
        bindsym Shift+0     gaps left all set 0

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}

mode "$mode_gaps_all" {
        bindsym j exec gaps outer current  plus 5; gaps inner current plus 5
        bindsym k exec gaps outer current  minus 5; gaps inner  current minus 5

        bindsym Shift+j exec gaps outer all plus 5; gaps inner all plus 5
        bindsym Shift+k exec gaps outer all minus 5; gaps inner all minus 5

        bindsym Return mode "$mode_gaps"
        bindsym Escape mode "default"
}

bindsym $mod+Shift+g mode "$mode_gaps"


