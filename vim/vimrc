"""" CUSTOM KEY BINDINGS """"""""""""""""""""""""""""""""""""""
" function keys
set pastetoggle=<F2>
nnoremap <F3> :ALEFix<CR>
nnoremap <F4> : NERDTreeToggle<CR>
nnoremap <leader><F4> :NERDTreeFind<CR>
noremap <F5> :call KeyCheat() <CR>
nnoremap <F6> :call VimCheat() <CR>
nnoremap <F8> :TagbarToggle<CR>
noremap <F9> :set hlsearch! hlsearch?<CR>
nnoremap <buffer> <F12> :exec extension_command<Bar>exec 'resize 40'<CR>

" Hovering
nnoremap <silent> <leader>h :ALEHover<CR>

" References
nnoremap <silent> <leader>r :ALEFindReferences<CR>

" Linting Jump
nnoremap <silent> <leader>j :ALENext<CR>
nnoremap <silent> <leader>k :ALEPrevious<CR>

" Jump to Definitions
nnoremap <silent> <Leader>d :ALEGoToDefinition<CR>
