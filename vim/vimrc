"""" CUSTOM KEY BINDINGS """"""""""""""""""""""""""""""""""""""
" remap folding
nnoremap <leader><leader> za

" function keys
nmap <leader>1 <Plug>(run_tests)
nmap <leader>2 <Plug>(create_scratchpad_vertical)
nnoremap <leader>4 :ALEFix<CR>
nnoremap <leader>8 :Vista!!<CR>
nmap <leader>9 <Plug>(run_code)

" ALE shortcuts
nnoremap <silent> <leader>h :ALEHover<CR>
nnoremap <silent> <leader>e :ALEDetail<CR>
nnoremap <silent> <leader>r :ALEFindReferences -relative<CR>
nnoremap <silent> <leader>j :ALENext<CR>
nnoremap <silent> <leader>k :ALEPrevious<CR>
nnoremap <silent> <Leader>d :ALEGoToDefinition<CR>
nnoremap <silent> <Leader>n :ALEGoToDefinition -tab<CR>
nnoremap <silent> <Leader>v :ALEGoToDefinition -vsplit<CR>
nnoremap <silent> <Leader>x :ALEGoToDefinition -split<CR>

" undo tree
if has('nvim') || has('python3') || has('python')
  nnoremap <silent> <Leader>u :MundoToggle<CR>
else
  nnoremap <silent> <Leader>u :UndotreeToggle<CR>
endif

" fuzzy file/word finder key
nnoremap <leader>f :FZF<CR>
nnoremap <Leader>a :RgContents<CR>
nnoremap <Leader>g :Rg<CR>
nnoremap <Leader>b :Buffers<CR>
nnoremap <Leader>c :Commits<CR>
nnoremap <Leader>` :FZFMarks<CR>
nnoremap <Leader>* :execute 'Rg' expand('<cword>')<CR>
nnoremap <silent><Leader>m :call GitLinePopUp()<CR>

" quiet focused reading mode
nnoremap <Leader>q :Goyo <bar> Limelight!! <CR>

"""" TAB COMPLETION """"""""""""""""""""""""""""""""""""""""""""""""
" not sure what this does but is required for tab completion
function! s:check_back_space() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" Completion Bound to TAB
inoremap <silent> <expr> <TAB>
      \ pumvisible() ? "\<C-n>" :
      \ <SID>check_back_space() ? "\<TAB>" :
      \ '<C-\><C-O>:ALEComplete<CR>'
inoremap <silent> <expr><S-TAB> pumvisible() ? "\<C-p>" : ""

" Go to newline when popup menu is active instead of selecting completion
inoremap <silent> <expr> <CR>
      \ pumvisible() ? "<CR><CR>" : "<CR>"

" auto close preview window when the popup menu is not visible
autocmd! CompleteDone * if pumvisible() == 0 | pclose | endif

