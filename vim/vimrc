"""" CUSTOM KEY BINDINGS """"""""""""""""""""""""""""""""""""""
" remap folding
nnoremap <leader><leader> za

" function keys
noremap <leader>3 :call KeyCheat() <CR>
nnoremap <leader>4 :ALEFix<CR>
nnoremap <leader>5 : NERDTreeToggle<CR>
nnoremap <leader>6 :NERDTreeFind<CR>
nnoremap <leader>8 :TagbarToggle<CR>
nnoremap <buffer> <leader>9 :exec extension_command<Bar>exec 'resize 40'<CR>

" Hovering
nnoremap <silent> <leader>h :ALEHover<CR>

" References
nnoremap <silent> <leader>r :ALEFindReferences<CR>

" Linting Jump
nnoremap <silent> <leader>j :ALENext<CR>
nnoremap <silent> <leader>k :ALEPrevious<CR>

" Jump to Definitions
nnoremap <silent> <Leader>d :ALEGoToDefinition<CR>
nnoremap <silent> <Leader>n :ALEGoToDefinitionInTab<CR>
nnoremap <silent> <Leader>v :ALEGoToDefinitionInVSplit<CR>
nnoremap <silent> <Leader>s :ALEGoToDefinitionInSplit<CR>

" Completion Bound to TAB
inoremap <silent> <expr> <TAB>
      \ pumvisible() ? "\<C-n>" :
      \ <SID>check_back_space() ? "\<TAB>" :
      \ '<C-\><C-O>:ALEComplete<CR>'
inoremap <silent> <expr><S-TAB> pumvisible() ? "\<C-p>" : ""

" Go to newline when popup menu is active instead of selecting completion
inoremap <silent> <expr> <CR>
      \ pumvisible() ? "<CR><CR>" : "<CR>"

" auto close preview window when the popup menu is not visible
autocmd! CompleteDone * if pumvisible() == 0 | pclose | endif

" fuzzy file/word finder key
nnoremap <leader>f :FZF<CR>
nnoremap <Leader>a :Ag<CR>
" nnoremap <Leader>r :Rg<CR>
nnoremap <Leader>* :execute 'Ag' expand('<cword>')<CR>

