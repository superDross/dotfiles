inoremap <silent> <expr> <TAB>
      \ pumvisible() ? "\<C-n>" :
      \ <SID>check_back_space() ? "\<TAB>" :
      \ '<C-\><C-O>:ALEComplete<CR>'
inoremap <silent> <expr><S-TAB> pumvisible() ? "\<C-p>" : ""

" Go to newline when popup menu is active instead of selecting completion
inoremap <silent> <expr> <CR>
      \ pumvisible() ? "<CR><CR>" : "<CR>"

" auto close preview window when the popup menu is not visible
autocmd! CompleteDone * if pumvisible() == 0 | pclose | endif

" open terminal
nnoremap <silent> <Leader>t :term ++rows=15<CR>

" tab commands
nnoremap <C-j> :tabprevious<CR>
nnoremap <C-k> :tabnext<CR>
nnoremap <C-h> :tabprevious<CR>
nnoremap <C-l> :tabnext<CR>
noremap <leader>1 1gt
noremap <leader>2 2gt
noremap <leader>3 3gt
noremap <leader>4 4gt
noremap <leader>5 5gt
noremap <leader>6 6gt
noremap <leader>7 7gt
noremap <leader>8 8gt
noremap <leader>9 9gt
