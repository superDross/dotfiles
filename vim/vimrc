"""" NERDTree """""""""""""""""""""""""""""""""""""""""""""
" refresh the file tree upon opening
function! NERDTreeRefresh()
    if &filetype ==# 'nerdtree'
        silent exe substitute(mapcheck('R'), '<CR>', '', '')
    endif
endfunction

autocmd BufEnter * call NERDTreeRefresh()

