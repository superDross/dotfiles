"""" GLOBALS """""""""""""""""""""""""""""""""""
let g:vimrc = resolve(expand('<sfile>:p'))
let g:vimdir = fnamemodify(vimrc, ':h')

" for picobook
let g:notesdir = fnamemodify(vimdir, ':h') . '/notes/'
let g:noteurl = 'https://github.com/superDross/dotfiles/blob/master/notes/'
let g:browser = 'chromium'

function! SourceBaseRc(f)
  exec 'source ' . g:vimdir . '/' . a:f
endfunction

function! GitLinePopUp()
  " like git-messanger but with a popup
  " TODO: clean up
  call setbufvar(winbufnr(popup_atcursor(systemlist("cd " . shellescape(fnamemodify(resolve(expand('%:p')), ":h")) . " && git log --no-merges -n 1 -L " . shellescape(line("v") . "," . line(".") . ":" . resolve(expand("%:p")))), { "padding": [1,1,1,1], "pos": "botleft", "wrap": 0 })), "&filetype", "git")
endfunction

"""" SKELETON """""""""""""""""""""""""""""""""""""""""
" skeleton files
augroup templates
  execute 'autocmd BufNewFile *.sh 0r ' . g:vimdir . '/templates/template.sh'
augroup END

