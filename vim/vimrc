"""" FZF """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" use ag instead of find, whcih is faster and repects .gitignore
let $FZF_DEFAULT_COMMAND="rg --files --hidden --follow --glob '!.git'"

