"""" FUNCTIONS """""""""""""""""""""""""""""""""""
let g:vimrc = resolve(expand('<sfile>:p'))
let g:vimdir = fnamemodify(vimrc, ':h')

function! SourceBaseRc(f)
  exec 'source ' . g:vimdir . '/' . a:f
endfunction

" not sure what this does but is required for tab completion
function! s:check_back_space() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" assert & configure spell settings
function! Spelling()
  " required to allow mispellings to be highlighted
  let g:gruvbox_guisp_fallback='bg'
  colorscheme gruvbox
  set spell spelllang=en_gb
  hi clear SpellBad
  hi SpellBad cterm=underline ctermfg=Red
endfunction

