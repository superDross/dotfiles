{
	"workbench.colorTheme": "Gruvbox Dark (Hard)",
	// turn sticky scroll off as it can slow down vscode vim, apparently...
	"editor.stickyScroll.enabled": false,
	"editor.cursorBlinking": "solid",
	// stop background horizontal line on cursor and highlighting words unser the curosr
	"editor.renderLineHighlight": "none",
	"editor.occurrencesHighlight": "off",
	// tab completion like neovim (kind of a lot...)
	"editor.tabCompletion": "off",
	"editor.acceptSuggestionOnEnter": "on",
	"editor.suggest.snippetsPreventQuickSuggestions": false,
	"editor.suggestSelection": "first",
	// no minimap, its shite
	"editor.minimap.renderCharacters": false,
	"editor.minimap.enabled": false,
	"terminal.integrated.scrollback": 100000,
	// copilot disable inline suggestions
	"github.copilot.enable": {
		"*": false,
		"plaintext": true,
		"markdown": false,
		"scminput": false
	},
	// vim settings
	"vim.leader": "<space>",
	"vim.hlsearch": true,
	"vim.smartRelativeLine": true,
	"vim.useSystemClipboard": true,
	"vim.mouseSelectionGoesIntoVisualMode": false,
    "vim.highlightedyank.enable": true,
	"vim.foldfix": true,
	"vim.normalModeKeyBindingsNonRecursive": [
		{
			"before": [
				"<leader>",
				"z"
			],
			"commands": [
				"workbench.action.toggleZenMode"
			]
		},
		// turn off highlighting, not the same but fine
		{
			"before": [
				"<leader>",
				"0"
			],
			"commands": [
				":nohlsearch"
			]
		},
		{
			// toggle fold
			"before": [
				"<leader>",
				"<leader>"
			],
			"commands": [
				"editor.toggleFold"
			]
		},
		{
			// toggle side bar
			"before": [
				"<leader>",
				"b",
				"b"
			],
			"commands": [
				"outline.removeView",
				"workbench.action.toggleSidebarVisibility"
			]
		},
		{
			// open file explorer on the specific file
			"before": [
				"<leader>",
				"b",
				"r"
			],
			"commands": [
				"outline.removeView",
				"workbench.view.explorer"
			]
		},
		// fzf replacements
		{
			"before": [
				"<leader>",
				"f",
				"f"
			],
			"commands": [
				"workbench.action.quickOpen"
			]
		},
		{
			"before": [
				"<leader>",
				"f",
				"g"
			],
			"commands": [
				"workbench.action.quickTextSearch"
			]
		},
		{
			"before": [
				"<leader>",
				"f",
				"r"
			],
			"commands": [
				"editor.action.referenceSearch.trigger"
			]
		},
		// open terminal
		{
			"before": [
				"<leader>",
				"t"
			],
			"commands": [
				"workbench.action.terminal.toggleTerminal"
			]
		},
		// git commands vim style
		{
			"before": [
				"<leader>",
				"g",
				"a"
			],
			"commands": [
				"git.stage"
			]
		},
		{
			"before": [
				"<leader>",
				"g",
				"i"
			],
			"commands": [
				"gitlens.openFileOnRemote"
			]
		},
		{
			"before": [
				"<leader>",
				"g",
				"d"
			],
			"commands": [
				"gitlens.diffWithPrevious"
			]
		},
		{
			"before": [
				"<leader>",
				"g",
				"g"
			],
			"commands": [
				"workbench.view.scm"
			]
		},
		{
			"before": [
				"<leader>",
				"g",
				"b"
			],
			"commands": [
				"gitlens.toggleFileBlame:key"
			]
		},
		{
			"before": [
				"<leader>",
				"g",
				"c"
			],
			"commands": [
				"gitlens.composeCommits"
			]
		},
		// open chat window
		{
			"before": [
				"<leader>",
				"c",
				"t"
			],
			"commands": [
				"workbench.action.toggleAuxiliaryBar"
			]
		},
		// run current python file in terminal
		{
			"before": [
				"<leader>",
				"r",
				"c"
			],
			"commands": [
				"python.execInTerminal"
			]
		},
		// toggle symbols side bar
		{
			"before": [
				"<leader>",
				"8"
			],
			"commands": [
				"workbench.action.toggleSidebarVisibility",
				"outline.focus",
				"workbench.action.focusActiveEditorGroup"
			]
		},
		// lsp stuff
		{
			// TODO: stop from opening in a new tab
			"before": [
				"<leader>",
				"l",
				"d"
			],
			"commands": [
				"editor.action.revealDefinition"
			]
		},
		{
			"before": [
				"<leader>",
				"l",
				"t"
			],
			"commands": [
				"editor.action.revealDefinition"
			]
		},
		{
			"before": [
				"<leader>",
				"l",
				"v"
			],
			"commands": [
				"workbench.action.splitEditorRight",
				"editor.action.revealDefinition"
			]
		},
		{
			"before": [
				"<leader>",
				"l",
				"s"
			],
			"commands": [
				"workbench.action.splitEditorDown",
				"editor.action.revealDefinition"
			]
		},
		{
			"before": [
				"<leader>",
				"l",
				"h"
			],
			"commands": [
				"editor.action.showHover"
			]
		},
		{
			"before": [
				"<leader>",
				"l",
				"r"
			],
			"commands": [
				"editor.action.rename"
			]
		},
		{
			"before": [
				"<leader>",
				"l",
				"o"
			],
			"commands": [
				"editor.showCallHierarchy"
			],
			"when": "editorHasCallHierarchyProvider && editorTextFocus && !inReferenceSearchEditor"
		},
		// missing split navigation
		{
			"before": [
				"<C-w>",
				"<S-w>"
			],
			"commands": [
				"workbench.action.focusPreviousGroup"
			]
		},
		// copy/paste
		{
			"before": [
				"<leader>",
				"y"
			],
			"commands": [
				"editor.action.clipboardCopyAction"
			]
		},
		{
			"before": [
				"<leader>",
				"p"
			],
			"commands": [
				"editor.action.clipboardPasteAction"
			]
		},
		// go to next warning/error in file
		{
			"before": [
				"<leader>",
				"j"
			],
			"commands": [
				"editor.action.marker.nextInFiles"
			]
		},
		{
			"before": [
				"<leader>",
				"k"
			],
			"commands": [
				"editor.action.marker.prevInFiles"
			]
		},
		// ctrl+o & ctrl+i act weird this fixes it provided navigationScope is set to editorGroup
		{
			"before": [
				"<C-o>"
			],
			"commands": [
				"workbench.action.navigateBack"
			]
		},
		{
			"before": [
				"<C-i>"
			],
			"commands": [
				"workbench.action.navigateForward"
			]
		}
	],
	"vim.visualModeKeyBindings": [
		// run selected python code in terminal
		{
			"before": [
				"<leader>",
				"r",
				"s"
			],
			"commands": [
				"python.execSelectionInTerminal"
			]
		},
		// copy
		{
			"before": [
				"<leader>",
				"y"
			],
			"commands": [
				"editor.action.clipboardCopyAction"
			]
		},
		// copilot inline chat
		{
			"before": [
				"<leader>",
				"c",
				"c"
			],
			"commands": [
				"inlineChat.start"
			]
		},
		// toggle copilot completion on and off (DOES NOT WORK)
		{
			"before": [
				"<space>",
				"c",
				"o"
			],
			"commands": [
				"github.copilot.completions.toggle"
			]
		}
	],
	// ensures <leader>fg opens in a new preview tab (does not work when single editor tabs plugin is active)
	"workbench.editor.enablePreviewFromQuickOpen": true,
	// make vim plugin faster
	"vim.statusBarColorControl": false,
	"extensions.experimental.affinity": {
		"vscode.vim": 1
	},
	// ensure ctrl-o & ctrl-i work like vim (split context respected)
	"workbench.editor.navigationScope": "editorGroup",
	// ensure preview tabe is reused for go to definition
	"workbench.editor.enablePreview": true,
	"workbench.editor.enablePreviewFromCodeNavigation": true,
	// git inline stuff
	"git.blame.editorDecoration.enabled": false,
	"gitlens.ai.model": "vscode",
	"gitlens.ai.vscode.model": "copilot:gpt-4.1",
	"workbench.activityBar.location": "hidden"
}
