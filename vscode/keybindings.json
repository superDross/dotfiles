// Place your key bindings in this file to override the defaults
[
	{
		"key": "ctrl+l",
		"command": "workbench.action.nextEditor",
		"when": "!terminalFocus"
	},
	{
		"key": "alt+cmd+right",
		"command": "-workbench.action.nextEditor"
	},
	{
		"key": "ctrl+h",
		"command": "workbench.action.previousEditor"
	},
	{
		"key": "alt+cmd+left",
		"command": "-workbench.action.previousEditor"
	},
	{
		"key": "ctrl+w",
		"command": "-workbench.action.switchWindow"
	},
	{
		"key": "shift+down",
		"command": "workbench.action.decreaseViewHeight"
	},
	{
		"key": "shift+up",
		"command": "workbench.action.increaseViewHeight"
	},
	{
		"key": "shift+right",
		"command": "workbench.action.decreaseViewWidth"
	},
	{
		"key": "shift+left",
		"command": "workbench.action.increaseViewWidth"
	},
	// vim navigation
	{
		"key": "j",
		"command": "list.focusDown",
		"when": "listFocus && !inputFocus"
	},
	{
		"key": "k",
		"command": "list.focusUp",
		"when": "listFocus && !inputFocus"
	},
	{
		"key": "h",
		"command": "list.collapse",
		"when": "listFocus && !inputFocus"
	},
	{
		"key": "l",
		"command": "list.expand",
		"when": "listFocus && !inputFocus"
	},
	// vim window navigation outside editting mode, can be buggy...
	{
		"key": "ctrl+w w",
		"command": "workbench.action.focusNextGroup",
		"when": "!editorTextFocus"
	},
	{
		"key": "ctrl+w shift+w",
		"command": "workbench.action.focusPreviousGroup",
		"when": "!editorTextFocus"
	},
	{
		"key": "ctrl+w l",
		"command": "workbench.action.focusRightGroup",
		"when": "!editorTextFocus && !sideBarFocus"
	},
	{
		"key": "ctrl+w h",
		"command": "workbench.action.focusLeftGroup",
		"when": "!editorTextFocus && !auxiliaryBarFocus"
	},
	{
		"key": "ctrl+w j",
		"command": "workbench.action.focusBelowGroup",
		"when": "!editorTextFocus"
	},
	{
		"key": "ctrl+w k",
		"command": "workbench.action.focusAboveGroup",
		"when": "!editorTextFocus && !terminalFocus"
	},
	// vim like navigation in specific scenarios
	{
		"key": "ctrl+w k",
		"command": "workbench.action.focusNextGroup",
		"when": "terminalFocus"
	},
	{
		// this does not work amazingly well...
		"key": "ctrl+w l",
		"command": "workbench.action.focusPreviousGroup",
		"when": "sideBarFocus"
	},
	{
		// this does not work amazingly well...
		"key": "ctrl+w h",
		"command": "workbench.action.focusPreviousGroup",
		"when": "auxiliaryBarFocus"
	},
	// get rid of the icons on the left hand side
	{
		"key": "ctrl+shift+b",
		"command": "workbench.action.toggleActivityBarVisibility"
	},
	// completion like vim; tab for cycling suggestions and enter for selecting
	{
		"key": "tab",
		"command": "selectNextSuggestion",
		"when": "suggestWidgetVisible && textInputFocus"
	},
	{
		"key": "shift+tab",
		"command": "selectPrevSuggestion",
		"when": "suggestWidgetVisible && textInputFocus"
	},
	{
		"key": "enter",
		"command": "acceptSelectedSuggestion",
		"when": "suggestWidgetVisible && textInputFocus"
	},
	// copilot bindings like vim
	{
		"key": "ctrl+j",
		"command": "editor.action.inlineSuggest.commit",
		"when": "inlineEditIsVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible"
	},
	{
		"key": "tab",
		"command": "-editor.action.inlineSuggest.commit",
		"when": "inlineEditIsVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible"
	},
	// open file search results vertically
	{
		"key": "ctrl+v",
		"command": "quickInput.accept",
		"when": "inQuickInput && quickInputType != 'quickWidget'"
	},
	{
		"key": "ctrl+shift+p",
		"command": "github.copilot.completions.toggle"
	},
	{
		"key": "enter",
		"command": "list.select",
		"when": "explorerViewletVisible && filesExplorerFocus"
	},
	// file explorer
	{
		"key": "a",
		"command": "explorer.newFile",
		"when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
	},
	{
		"key": "shift+a",
		"command": "explorer.newFolder",
		"when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
	},
	{
		"key": "d",
		"command": "deleteFile",
		"when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
	},
	{
		"key": "r",
		"command": "renameFile",
		"when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
	},
	{
		"key": "y",
		"command": "copyFilePath",
		"when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
	},
	{
		"key": "s",
		"command": "runCommands",
		"when": "explorerViewletVisible && filesExplorerFocus && !inputFocus",
		"args": {
			"commands": [
				"workbench.action.splitEditorRight",
				"list.select"
			]
		}
	},
	{
		"key": "shift+s",
		"command": "runCommands",
		"when": "explorerViewletVisible && filesExplorerFocus && !inputFocus",
		"args": {
			"commands": [
				"workbench.action.splitEditorDown",
				"list.select"
			]
		}
	},
]
